        // NFP = first Friday of each month, 8:30 AM ET. Computed → never expires.
        private void LoadComputedNfp()
        {
            for (int yr = 2023; yr <= 2033; yr++)
            {
                for (int mo = 1; mo <= 12; mo++)
                {
                    DateTime d = new DateTime(yr, mo, 1);
                    while (d.DayOfWeek != DayOfWeek.Friday) d = d.AddDays(1);
                    newsEvents.Add(new DateTime(yr, mo, d.Day, 8, 30, 0));
                }
            }
        }

        private bool IsNewsDay(DateTime barTime)
        {
            foreach (var ev in newsEvents)
                if (ev.Date == barTime.Date) return true;
            return false;
        }

        private bool IsNewsBlackout(DateTime barTime)
        {
            foreach (var newsTime in newsEvents)
            {
                if (newsTime.Date != barTime.Date) continue;
                double minutesDiff = Math.Abs((barTime - newsTime).TotalMinutes);
                if (minutesDiff <= newsBufferMinutes)
                {
                    if (!newsHaltActive)
                    {
                        newsHaltActive = true;
                        Print(barTime + " NEWS BLACKOUT — within " + newsBufferMinutes
                            + " min of event at " + newsTime.ToString("HH:mm"));
                    }
                    return true;
                }
            }
            if (newsHaltActive)
            {
                newsHaltActive = false;
                Print(barTime + " NEWS BLACKOUT lifted");
            }
            return false;
        }

        // FIX A/C/D (2026-07-24) — is this bar inside RTH (09:30–15:59)?
        // Used for the reset trigger, session high/low, and VWAP accumulation so all
        // three key off ONE definition of the session.
        private bool IsRthBar(int hour, int minute)
        {
            if (hour < SESSION_OPEN_HOUR || hour >= SESSION_CLOSE_HOUR) return false;
            if (hour == SESSION_OPEN_HOUR && minute < SESSION_OPEN_MINUTE) return false;
            return true;
        }

        protected override void OnBarUpdate()
        {
            if (CurrentBar < BarsRequiredToTrade) return;
            if (CurrentBar < emaPeriod) return;
            if (evalPassed) return;

            // ── Capture starting balance on first bar ──────
            if (startingBalance == 0)
            {
                startingBalance = Account.Get(AccountItem.CashValue, Currency.UsDollar);
                dayStartEquity  = startingBalance;
                Print(Time[0] + " Starting balance: $" + startingBalance.ToString("F2"));
                SendDiscordAlert("STARTED | Balance: $" + startingBalance.ToString("F2"));
            }

            int hour   = Time[0].Hour;
            int minute = Time[0].Minute;
            bool inRth = IsRthBar(hour, minute);

            // ══ SESSION HIGH/LOW — FIX C REVERTED (2026-07-24b) ══
            // Tracks from 09:00, and runs BEFORE the reset, exactly as the original.
            // I previously "fixed" this to RTH-only. That was WRONG and it cost 56% of
            // trading days: the 09:00–09:29 pre-open IS legitimately available at the
            // 09:30 decision, so the original filter was measuring "yesterday's RTH +
            // today's pre-open" — a better-informed volatility estimate than yesterday's
            // RTH alone. Removing it shrank prior-range values, pushing most days under
            // MinSessionRange=150. Measured: 792 -> 389 trades, eval pass 42% -> 29%.
            // Same lesson as the OR-anchored-blocks experiment: looked like
            // contamination, was actually load-bearing signal. DO NOT re-"fix" this.
            if (hour >= SESSION_OPEN_HOUR && hour < SESSION_CLOSE_HOUR)
            {
                if (sessionHigh == 0 || High[0] > sessionHigh) sessionHigh = High[0];
                if (sessionLow  == 0 || Low[0]  < sessionLow)  sessionLow  = Low[0];
            }

            // ══ 1. SESSION RESET — FIX B ══════════════════
            // Date-keyed: fires on the FIRST RTH bar of a new calendar date. Immune to a
            // missing 09:30 bar. Runs BEFORE session high/low and VWAP accumulation so
            // the 09:30 bar itself belongs to the NEW session (FIX C/D).
            if (inRth && Time[0].Date != lastResetDate)
            {
                lastResetDate = Time[0].Date;

                // Evaluate the PRIOR session's range before clearing it.
                if (sessionHigh > 0 && sessionLow > 0)
                {
                    prevSessionHigh = sessionHigh;
                    prevSessionLow  = sessionLow;
                    double priorRange = prevSessionHigh - prevSessionLow;
                    bool tooQuiet    = minSessionRange > 0    && priorRange < minSessionRange;
                    bool tooChaotic  = maxSessionRange < 9999 && priorRange > maxSessionRange;
                    sessionRangeOk   = !tooQuiet && !tooChaotic;
                    string rangeStatus = sessionRangeOk ? "TRADE TODAY ✅" : "SKIP TODAY ⛔";
                    Print(Time[0] + " PRIOR RANGE: " + priorRange.ToString("F1") + " pts | " + rangeStatus
                        + (tooQuiet   ? " (too quiet <"   + minSessionRange + ")" : "")
                        + (tooChaotic ? " (too chaotic >" + maxSessionRange + ")" : ""));
                    SendDiscordAlert("SESSION | Range: " + priorRange.ToString("F0") + "pts | " + rangeStatus);
                }
                else
                {
                    // No complete prior session yet (start of a backtest). Stay CLOSED
                    // rather than defaulting open — this is the first-day artifact fix.
                    sessionRangeOk = false;
                    Print(Time[0] + " PRIOR RANGE: unavailable (warm-up) | SKIP TODAY ⛔");
                }

                // Reset session tracking
                sessionHigh = 0;
                sessionLow  = 0;

                tradedToday    = false;
                dailyHalted    = false;
                lastBullishRej = false;
                lastBearishRej = false;
                lastRejHigh    = 0;
                lastRejLow     = 0;
                vwapCumTPVol   = 0;
                vwapCumVol     = 0;
                trailActive    = false;
                partialTaken   = false;
                realizedTradePnl = 0;
                actualEntryFill  = 0;
                highWaterMark  = 0;
                lowWaterMark   = 0;
                tradeSide      = "";
                initialRisk    = 0;
                dayStartEquity = Account.Get(AccountItem.CashValue, Currency.UsDollar);
                todayProfit    = 0;
                consecLosses   = 0;
                consecHalted   = false;
                newsHaltActive = false;

                if (skipToday)
                    Print(Time[0] + " MANUAL SKIP TODAY enabled");
            }

            // ══ 3. VWAP ACCUMULATION — FIX D ══════════════
            // RTH only, after the reset. Behaviourally identical to before (the old
            // 09:00–09:29 accumulation was zeroed at 09:30 anyway) — defensive.
            if (inRth)
            {
                double hlc3   = (High[0] + Low[0] + Close[0]) / 3.0;
                vwapCumTPVol += hlc3 * Volume[0];
                vwapCumVol   += Volume[0];
            }

            // ── Prop firm checks ──────────────────────────
            CheckPropFirmRules();

            // ── Manage open position ──────────────────────
            if (Position.MarketPosition != MarketPosition.Flat)
            {
                ManagePosition();
                return;
            }

            // ── All entry gates ───────────────────────────
            if (skipToday)       return;
            if (!sessionRangeOk) return;
            if (dailyHalted)     return;
            if (evalPassed)      return;
            if (consecHalted)    return;
            if (tradedToday)     return;

            // ── Lunch hour filter 12:00–13:30 ET ──────────
            if ((hour == 12) || (hour == 13 && minute < 30)) return;

            // ── News blackout ─────────────────────────────
            if (skipNewsDayEntirely && IsNewsDay(Time[0])) return;   // whole-day skip
            if (IsNewsBlackout(Time[0])) return;

            // ══ TRADING HOURS — FIX A ═════════════════════
            // Was: if (hour < 9 || hour >= 15) return;   <-- opened at 09:00, 30 minutes
            // before any session state was reset. Now gated to the RTH open.
            if (!inRth)                     return;
            if (hour >= ENTRY_CUTOFF_HOUR)  return;

            // ── VWAP / EMA ready ──────────────────────────
            if (vwapCumVol == 0 || ema == null) return;

            DetectRejections();
            TryEntry();
        }

        // ─── FIX 2 + stop/PnL accounting (2026-05, unchanged) ──
        protected override void OnExecutionUpdate(
            Execution execution,
            string executionId,
            double price,
            int quantity,
            MarketPosition marketPosition,
            string orderId,
            DateTime time)
        {
            if (execution.Order == null) return;

            OrderAction action = execution.Order.OrderAction;
            string      name   = execution.Order.Name;

            // (A) Exit fills — Sell closes a long, BuyToCover closes a short.
            if (actualEntryFill > 0)
            {
                if (action == OrderAction.Sell)
                    realizedTradePnl += (price - actualEntryFill) * quantity * 2;
                else if (action == OrderAction.BuyToCover)
                    realizedTradePnl += (actualEntryFill - price) * quantity * 2;
            }

            // (B) Entry fill → tradedToday + capture entry price from the execution.
            if ((name == "RB Long" || name == "RB Short") && actualEntryFill == 0
                && (action == OrderAction.Buy || action == OrderAction.SellShort))
            {
                tradedToday     = true;
                actualEntryFill = price;
                Print(time + " FILL CONFIRMED | " + name + " @ " + price.ToString("F2")
                    + " | stop=" + stopPrice.ToString("F2"));
            }
        }

        // ─── Trade close detection (broker-managed exits, unchanged) ─
        protected override void OnPositionUpdate(
            Position position,
            double averagePrice,
            int quantity,
            MarketPosition marketPosition)
        {
            if (marketPosition == MarketPosition.Flat && tradeSide != "")
            {
                string side     = tradeSide;
                string exitType = trailActive ? "TRAIL EXIT" : "STOP/EXIT";

                UpdateConsecLosses(realizedTradePnl);
                Print(Time[0] + " TRADE CLOSED " + side + " (" + exitType + ")"
                    + " netPnl=$" + realizedTradePnl.ToString("F2"));
                SendDiscordAlert((realizedTradePnl >= 0 ? "✅" : "❌") + " " + side.ToUpper()
                    + " (" + exitType + ") | PnL: "
                    + (realizedTradePnl >= 0 ? "+$" : "-$") + Math.Abs(realizedTradePnl).ToString("F2"));

                realizedTradePnl = 0;
                actualEntryFill  = 0;
                tradeSide        = "";
                partialTaken     = false;
                trailActive      = false;
            }
        }

        private void DetectRejections()
        {
            double o         = Open[0];
            double h         = High[0];
            double l         = Low[0];
            double c         = Close[0];
            double body      = Math.Abs(c - o);
            bool   validBody = body > 0;
            double upperWick = h - Math.Max(o, c);
            double lowerWick = Math.Min(o, c) - l;

            bool bearishRej = validBody
                && upperWick > body * wickRatio
                && c < o
                && lowerWick < body * 0.5;

            bool bullishRej = validBody
                && lowerWick > body * wickRatio
                && c > o
                && upperWick < body * 0.5;

            if (bearishRej)
            {
                lastRejHigh    = h;
                lastRejLow     = l;
                lastBearishRej = true;
                lastBullishRej = false;
                Print(Time[0] + " BEARISH REJ h=" + h + " l=" + l);
            }
            if (bullishRej)
            {
                lastRejHigh    = h;
                lastRejLow     = l;
                lastBullishRej = true;
                lastBearishRej = false;
                Print(Time[0] + " BULLISH REJ h=" + h + " l=" + l);
            }
        }

        private void TryEntry()
        {
            double vwap   = vwapCumTPVol / vwapCumVol;
            double emaVal = ema[0];
            double c      = Close[0];

            // ── Long entry ────────────────────────────────
            // NOTE (2026-07-24): `lastRejLow * 1.001` is a PERCENT tolerance, so it
            // scales with price level (~19 pts at MNQ 19k, ~30 pts at 30k). Left as-is
            // here deliberately — converting it to an explicit point parameter is a
            // separate experiment, not part of the session-boundary fix.
            if (lastBullishRej
                && lastRejLow > 0
                && c <= lastRejLow * 1.001
                && c > vwap
                && c > emaVal)
            {
                double sl          = lastRejLow - slBuffer;
                double riskDollars = (c - sl) * contracts * 2;
                if (riskDollars > maxLossDollars)
                    sl = c - (maxLossDollars / (contracts * 2));

                stopPrice     = sl;
                entryPrice    = c;
                initialRisk   = c - sl;
                highWaterMark = c;
                trailActive   = false;
                partialTaken  = false;
                realizedTradePnl = 0;
                actualEntryFill  = 0;
                tradeSide     = "long";

                double hardSl = c - Math.Max(hardStopPts, c - sl);
                SetStopLoss("RB Long", CalculationMode.Price, hardSl, false);
                EnterLong(contracts, "RB Long");

                Print(Time[0] + " LONG hardStop=" + hardSl.ToString("F2"));

                Print(Time[0] + " LONG entry=" + c.ToString("F2")
                    + " sl=" + sl.ToString("F2")
                    + " 1R=" + (c + initialRisk).ToString("F2")
                    + " vwap=" + vwap.ToString("F2")
                    + " ema=" + emaVal.ToString("F2"));

                SendDiscordAlert("📈 LONG | " + c.ToString("F2")
                    + " | SL: " + sl.ToString("F2")
                    + " | 1R: " + (c + initialRisk).ToString("F2")
                    + " | " + Time[0].ToString("HH:mm ET"));
            }

            // ── Short entry ───────────────────────────────
            else if (lastBearishRej
                && lastRejHigh > 0
                && c >= lastRejHigh * 0.999
                && c < vwap
                && c < emaVal)
            {
                double sl          = lastRejHigh + slBuffer;
                double riskDollars = (sl - c) * contracts * 2;
                if (riskDollars > maxLossDollars)
                    sl = c + (maxLossDollars / (contracts * 2));

                stopPrice    = sl;
                entryPrice   = c;
                initialRisk  = sl - c;
                lowWaterMark = c;
                trailActive  = false;
                partialTaken = false;
                realizedTradePnl = 0;
                actualEntryFill  = 0;
                tradeSide    = "short";

                double hardSl = c + Math.Max(hardStopPts, sl - c);
                SetStopLoss("RB Short", CalculationMode.Price, hardSl, false);
                EnterShort(contracts, "RB Short");

                Print(Time[0] + " SHORT hardStop=" + hardSl.ToString("F2"));

                Print(Time[0] + " SHORT entry=" + c.ToString("F2")
                    + " sl=" + sl.ToString("F2")
                    + " 1R=" + (c - initialRisk).ToString("F2")
                    + " vwap=" + vwap.ToString("F2")
                    + " ema=" + emaVal.ToString("F2"));

                SendDiscordAlert("📉 SHORT | " + c.ToString("F2")
                    + " | SL: " + sl.ToString("F2")
                    + " | 1R: " + (c - initialRisk).ToString("F2")
                    + " | " + Time[0].ToString("HH:mm ET"));
            }
        }

        private void ManagePosition()
        {
            double c = Close[0];

            // FIX 1 (2026-05) — post-fill logic uses the real fill price.
            double fillPrice = Position.AveragePrice;

            if (tradeSide == "long")
            {
                if (High[0] > highWaterMark)
                    highWaterMark = High[0];

                if (!partialTaken && initialRisk > 0
                    && c >= fillPrice + initialRisk
                    && Position.Quantity > 1)
                {
                    ExitLong(1, "Partial TP", "RB Long");
                    partialTaken = true;
                    stopPrice    = fillPrice;   // soft stop → breakeven
                    Print(Time[0] + " PARTIAL TP long @ " + c.ToString("F2")
                        + " soft→BE " + fillPrice.ToString("F2"));
                    SendDiscordAlert("✂️ PARTIAL TP LONG | " + c.ToString("F2")
                        + " | Soft stop → BE: " + fillPrice.ToString("F2"));
                }

                double profitPts = highWaterMark - fillPrice;
                if (profitPts >= trailActivation && !trailActive)
                {
                    trailActive = true;
                    Print(Time[0] + " TRAIL ACTIVATED long");
                }
                if (trailActive)
                {
                    double newStop = highWaterMark - trailOffset;
                    if (newStop > stopPrice) stopPrice = newStop;
                }

                if (c <= stopPrice)
                {
                    ExitLong("SL", "RB Long");
                    Print(Time[0] + " SOFT STOP long @ " + c.ToString("F2"));
                }
            }
            else if (tradeSide == "short")
            {
                if (Low[0] < lowWaterMark || lowWaterMark == 0)
                    lowWaterMark = Low[0];

                if (!partialTaken && initialRisk > 0
                    && c <= fillPrice - initialRisk
                    && Position.Quantity > 1)
                {
                    ExitShort(1, "Partial TP", "RB Short");
                    partialTaken = true;
                    stopPrice    = fillPrice;   // soft stop → breakeven
                    Print(Time[0] + " PARTIAL TP short @ " + c.ToString("F2")
                        + " soft→BE " + fillPrice.ToString("F2"));
                    SendDiscordAlert("✂️ PARTIAL TP SHORT | " + c.ToString("F2")
                        + " | Soft stop → BE: " + fillPrice.ToString("F2"));
                }

                double profitPts = fillPrice - lowWaterMark;
                if (profitPts >= trailActivation && !trailActive)
                {
                    trailActive = true;
                    Print(Time[0] + " TRAIL ACTIVATED short");
                }
                if (trailActive)
                {
                    double newStop = lowWaterMark + trailOffset;
                    if (newStop < stopPrice) stopPrice = newStop;
                }

                if (c >= stopPrice)
                {
                    ExitShort("SL", "RB Short");
                    Print(Time[0] + " SOFT STOP short @ " + c.ToString("F2"));
                }
            }
        }

        private void UpdateConsecLosses(double pnl)
        {
            if (pnl > 0)
            {
                consecLosses = 0;
                consecHalted = false;
                Print(Time[0] + " WIN — consecLosses reset");
            }
            else
            {
                consecLosses++;
                Print(Time[0] + " LOSS — consecLosses=" + consecLosses);
                if (consecLosses >= maxConsecLosses)
                {
                    consecHalted = true;
                    Print(Time[0] + " CONSEC LOSS HALT");
                    SendDiscordAlert("⛔ CONSEC HALT | " + consecLosses + " consecutive losses");
                }
            }
        }

        private void CheckPropFirmRules()
        {
            if (startingBalance == 0) return;

            double equity = Account.Get(AccountItem.CashValue, Currency.UsDollar);
            todayProfit   = equity - dayStartEquity;
            totalProfit   = equity - startingBalance;

            if (totalProfit >= profitTarget && !targetReached)
            {
                targetReached = true;
                Print(Time[0] + " PROFIT TARGET REACHED $" + totalProfit.ToString("F2"));
                if (stopAtProfitTarget)
                {
                    evalPassed = true;
                    ExitLong("Eval Passed", "RB Long");
                    ExitShort("Eval Passed", "RB Short");
                    SendDiscordAlert("🏆 EVAL PASSED! Total: +$" + totalProfit.ToString("F2")
                        + " | CHECK LUCID ACCOUNT NOW!");
                    return;
                }
                SendDiscordAlert("🏆 PROFIT TARGET HIT (+$" + totalProfit.ToString("F2")
                    + ")! Funded stage — bot KEEPS TRADING. Check Lucid.");
            }

            double drawdown = startingBalance - equity;
            if (drawdown >= maxDrawdown && !dailyHalted)
            {
                dailyHalted = true;
                ExitLong("DD Halt", "RB Long");
                ExitShort("DD Halt", "RB Short");
                Print(Time[0] + " DRAWDOWN HALT $" + drawdown.ToString("F2"));
                SendDiscordAlert("🚨 DRAWDOWN HALT | -$" + drawdown.ToString("F2")
                    + " | Limit: $" + maxDrawdown.ToString("F2"));
                return;
            }

            if (todayProfit >= dailyProfitCap && !dailyHalted)
            {
                dailyHalted = true;
                ExitLong("Daily Cap", "RB Long");
                ExitShort("Daily Cap", "RB Short");
                Print(Time[0] + " DAILY PROFIT CAP HIT $" + todayProfit.ToString("F2"));
                SendDiscordAlert("💰 DAILY CAP HIT | Today: +$" + todayProfit.ToString("F2")
                    + " | Done for the day ✅");
                return;
            }
        }
